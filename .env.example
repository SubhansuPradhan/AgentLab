# LLM provider — Ollama running locally, this is the only provider
# this project is configured to use. Make sure `ollama serve` is
# running and you've run `ollama pull qwen3.5:4b` before starting.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Database — PostgreSQL. Update user/password/db name to match
# whatever you create locally (see README setup steps).
DATABASE_URL=postgresql://postgres:postgrespass@localhost:5432/agentlab

# MLflow
MLFLOW_TRACKING_URI=./mlruns
